{
  "name": "create-atom-stack",
  "version": "1.0.5",
  "description": "Scaffold a production-ready Next.js App Router project with atomic design, Zustand, Tailwind CSS v4, and Conventional Commits.",
  "type": "module",
  "bin": {
    "create-atom-stack": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --target node18",
    "dev": "tsup src/index.ts --format esm --out-dir dist --watch --target node18",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hakizimana-fred/create-atom-stack.git"
  },
  "files": [
    "dist",
    "README.md",
    "atomstack.png"
  ],
  "keywords": [
    "nextjs",
    "scaffold",
    "atomic-design",
    "typescript",
    "tailwindcss",
    "create",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tinyglobby": "^0.2.16",
    "tsup": "^8.3.0",
    "typescript": "^5"
  }
}
